RewriteEngine On

# Block web access to maintenance / debug scripts (use CLI: php script.php)
<FilesMatch "^(migrate_.*\.php|ztest\.php|zzzzzzz\.php|fix_old_loan_days\.php|fix_pending_disbursal\.php|webhook_data\.txt)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Proxy /zxc/uploads/<file> to user/file.php?f=<file>
RewriteRule ^zxc/uploads/(.+)$ user/file.php?f=$1 [L,QSA]