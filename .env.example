# Copy to .env and fill in real values. Never commit .env.

# Database
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=credit

# AWS S3 (config_s3.php) — leave keys empty on EC2; use instance IAM role
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=creditlab.in
S3_REGION=ap-south-1
# S3 object prefix for zxc docs (default zxc/uploads/)
S3_ZXC_PREFIX=zxc/uploads/

# Pocket bridge API (api/pocket/) for external apps in other AWS accounts
POCKET_API_TOKEN=
# Optional comma-separated IPs allowed to call the pocket API
POCKET_API_ALLOWED_IPS=

# Set to 1 only for local dev if PHP cURL lacks CA bundle (insecure)
S3_CURL_SKIP_SSL_VERIFY=0

# SMTP (Hostinger / app mail)
MAIL_SMTP_HOST=smtp.hostinger.com
MAIL_SMTP_PORT=465
MAIL_SMTP_USER=Note@creditlab.in
MAIL_SMTP_PASSWORD=
MAIL_SMTP_SECURE=ssl
MAIL_FROM_NAME=CreditLab

# Easebuzz payment gateway
EASEBUZZ_MERCHANT_KEY=
EASEBUZZ_SALT=
EASEBUZZ_ENV=prod
# Production: set to 1 to enable payment/autocollect_playground_prod.php (live api.easebuzz.in).
# UAT sandbox playground (autocollect_playground.php) uses hardcoded UAT keys when EASEBUZZ_ENV=test or always on that page.
EASEBUZZ_AUTOCOLLECT_PLAYGROUND=0

# SMS gateway (smswala / k7marketinghub)
SMS_API_KEY=
SMS_API_PASSWORD=

# Signzy Digilocker
SIGNZY_API_KEY=
SIGNZY_API_SECRET=

# Internal token for /zxc/ PDF mailer and protected document URLs (?token=)
ZXC_INTERNAL_TOKEN=

# Optional: validate Easebuzz webhooks when hash is not in POST body
EASEBUZZ_WEBHOOK_SECRET=

# Application
APP_DEBUG=0
